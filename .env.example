# ==============================================================================
# CV Reviewer: environment configuration
# ==============================================================================
# Copy this file to `.env` and populate your API key if you wish to use live
# Google Gemini LLM inference.
#
# Privacy Note:
# - Document extraction, ATS layout inspection, structural parsing, scoring
#   aggregation, interactive editing, and DOCX/PDF export happen 100% locally.
# - When GEMINI_API_KEY is configured and LLM mode is enabled, extracted CV text
#   and optional Job Description text are sent to the Google Gemini API solely
#   for structured evaluation. Uploaded files are parsed in memory and never
#   stored permanently on disk.
# - If GEMINI_API_KEY is left blank, the application automatically runs using
#   its built-in Local Deterministic Recruiter Analysis Engine.

# Optional. Google Gemini API key from https://aistudio.google.com/app/apikey
# (see "Getting API keys" in README.md). Leave blank to run deterministic-only.
# Example: GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=

# Configurable Gemini Model Identifier
# Supported official models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Maximum accepted upload size in megabytes (enforced by the upload endpoint).
MAX_UPLOAD_MB=10

# Read into AppConfig but not currently used to start the server: the bind
# address and port come from the uvicorn command line (--host / --port).
HOST=127.0.0.1
PORT=8000

# Read into AppConfig; reserved, not currently used by the analysis.
DEFAULT_LANGUAGE=en-GB
